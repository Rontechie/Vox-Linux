import qs
import Quickshell
import qs.services
import qs.modules.common
import qs.modules.common.widgets
import QtQuick
import QtQuick.Layouts
import Qt5Compat.GraphicalEffects

// Dashboard header: current wallpaper, a soft black gradient at the bottom,
// profile picture + name and uptime in the bottom-left corner.
Item {
    id: root
    readonly property string wallpaper: Config.options.background.wallpaperPath || Config.options.background.thumbnailPath
    readonly property string facePath: "file://" + Quickshell.env("HOME") + "/.face"

    Layout.fillWidth: true
    implicitHeight: 128

    Rectangle { // rounded mask for the image
        id: roundMask
        anchors.fill: parent
        radius: Appearance.rounding.large
        visible: false
    }

    Item {
        anchors.fill: parent
        layer.enabled: true
        layer.effect: OpacityMask { maskSource: roundMask }

        Rectangle { // fallback when there is no usable wallpaper
            anchors.fill: parent
            color: Appearance.colors.colLayer1
        }
        Image {
            anchors.fill: parent
            source: root.wallpaper !== "" ? (root.wallpaper.startsWith("file://") ? root.wallpaper : "file://" + root.wallpaper) : ""
            fillMode: Image.PreserveAspectCrop
            asynchronous: true
            cache: true
            sourceSize.width: 900
        }
        Rectangle { // soft black gradient, stronger at the bottom so the text stays readable
            anchors.fill: parent
            gradient: Gradient {
                GradientStop { position: 0.35; color: "#00000000" }
                GradientStop { position: 1.0; color: "#b3000000" }
            }
        }
    }

    RowLayout {
        anchors {
            left: parent.left
            bottom: parent.bottom
            leftMargin: 14
            bottomMargin: 12
        }
        spacing: 10

        Item { // profile picture, falls back to a person icon
            Layout.preferredWidth: 44
            Layout.preferredHeight: 44

            Rectangle {
                id: avatarMask
                anchors.fill: parent
                radius: width / 2
                visible: false
            }
            Rectangle {
                anchors.fill: parent
                radius: width / 2
                color: Appearance.colors.colSecondaryContainer
                border.width: 2
                border.color: "#e6ffffff"
                MaterialSymbol {
                    anchors.centerIn: parent
                    visible: face.status !== Image.Ready
                    text: "person"
                    fill: 1
                    iconSize: 26
                    color: Appearance.m3colors.m3onSecondaryContainer
                }
            }
            Image {
                id: face
                anchors.fill: parent
                anchors.margins: 2
                source: root.facePath
                fillMode: Image.PreserveAspectCrop
                asynchronous: true
                visible: status === Image.Ready
                layer.enabled: true
                layer.effect: OpacityMask { maskSource: avatarMask }
            }
        }

        ColumnLayout {
            spacing: 0
            StyledText {
                text: SystemInfo.username
                font.pixelSize: Appearance.font.pixelSize.larger
                font.weight: Font.Medium
                color: "white"
            }
            RowLayout {
                spacing: 4
                MaterialSymbol {
                    text: "schedule"
                    iconSize: Appearance.font.pixelSize.normal
                    color: "#ccffffff"
                }
                StyledText {
                    text: Translation.tr("Up %1").arg(DateTime.uptime)
                    font.pixelSize: Appearance.font.pixelSize.smaller
                    color: "#ccffffff"
                }
            }
        }
    }
}
